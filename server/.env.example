# Copy this file to server/.env and fill in your values.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_seat_reservation
# Long random string, e.g. generated with: openssl rand -hex 32
AUTH_TOKEN_SECRET=
# Public URL of the server (used for links in the admin dashboard)
PUBLIC_BASE_URL=http://127.0.0.1:3000
