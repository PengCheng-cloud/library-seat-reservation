.assistant-results-hero {
  background: linear-gradient(145deg, rgba(244, 248, 255, 0.98) 0%, rgba(232, 241, 255, 0.96) 100%);
}

.assistant-results-tags {
  margin-top: 18rpx;
}

.assistant-model-evidence {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 18% 20%, rgba(93, 150, 232, 0.16) 0%, transparent 28%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(239, 246, 255, 0.92) 100%);
  border: 1rpx solid rgba(194, 214, 240, 0.72);
  overflow: hidden;
}

.assistant-model-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.assistant-model-kicker {
  display: block;
  font-size: 20rpx;
  color: #6882a2;
}

.assistant-model-title {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #10243d;
}

.assistant-model-badge {
  flex: 0 0 auto;
  max-width: 260rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(44, 108, 223, 0.1);
  color: #2c6cdf;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.4;
}

.assistant-model-desc,
.assistant-model-runtime,
.assistant-model-note {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #6882a2;
}

.assistant-model-runtime {
  color: #2c6cdf;
  font-weight: 700;
}

.assistant-model-live-visual {
  display: grid;
  grid-template-columns: 92rpx 1fr 92rpx;
  align-items: center;
  gap: 10rpx;
  margin-top: 22rpx;
}

.assistant-model-node {
  width: 92rpx;
  height: 68rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(194, 214, 240, 0.8);
  color: #10243d;
  font-size: 21rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(44, 108, 223, 0.08);
}

.assistant-model-node--active,
.assistant-model-node--target {
  background: #163c72;
  color: #ffffff;
}

.assistant-model-node--target {
  background: #2c6cdf;
}

.assistant-model-pulse-line {
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(44, 108, 223, 0.14);
  overflow: hidden;
}

.assistant-model-pulse-dot {
  width: 42%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, rgba(44, 108, 223, 0.08), rgba(44, 108, 223, 0.95));
  animation: assistantModelFlow 1.22s ease-in-out infinite;
}

.assistant-model-pulse-dot--late {
  animation-delay: 0.28s;
}

.assistant-model-chip-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.assistant-model-chip {
  min-width: 0;
  padding: 16rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(194, 214, 240, 0.72);
}

.assistant-model-chip--neural {
  background: #163c72;
  border-color: rgba(22, 60, 114, 0.2);
}

.assistant-model-chip-value {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #10243d;
}

.assistant-model-chip-label {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.4;
  color: #6882a2;
}

.assistant-model-chip--neural .assistant-model-chip-value,
.assistant-model-chip--neural .assistant-model-chip-label {
  color: #ffffff;
}

.assistant-model-note {
  color: #5f7591;
}

.assistant-model-metric-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.assistant-model-metric {
  min-width: 0;
  padding: 16rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(238, 245, 255, 0.96);
  border: 1rpx solid rgba(194, 214, 240, 0.72);
}

.assistant-model-metric-value {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #10243d;
}

.assistant-model-metric-label {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.45;
  color: #6882a2;
}

.assistant-model-process {
  display: grid;
  gap: 10rpx;
  margin-top: 18rpx;
}

.assistant-model-process-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.assistant-model-process-index {
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(44, 108, 223, 0.1);
  color: #2c6cdf;
  font-size: 18rpx;
  font-weight: 700;
}

.assistant-model-process-text {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  line-height: 1.55;
  color: #5f7591;
}

.assistant-results-list {
  display: grid;
}

.assistant-results-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(210, 224, 244, 0.9);
}

.assistant-results-row:first-child {
  padding-top: 0;
  border-top: 0;
}

.assistant-results-rank {
  width: 92rpx;
  min-height: 60rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(44, 108, 223, 0.08);
  color: #2c6cdf;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.assistant-results-main {
  flex: 1;
  min-width: 0;
}

.assistant-results-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.assistant-results-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #10243d;
}

.assistant-results-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6882a2;
}

.assistant-results-reasons {
  margin-top: 12rpx;
}

.assistant-results-model {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #2c6cdf;
}

.assistant-results-algorithm {
  display: grid;
  gap: 6rpx;
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(238, 245, 255, 0.92) 0%, rgba(255, 255, 255, 0.88) 100%);
  border: 1rpx solid rgba(194, 214, 240, 0.72);
}

.assistant-results-algorithm-line {
  display: block;
  font-size: 20rpx;
  line-height: 1.5;
  color: #5f7591;
}

.assistant-results-feature-panel {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f9fbff 0%, #f2f7ff 100%);
  border: 1rpx solid rgba(194, 214, 240, 0.72);
}

.assistant-results-feature-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.assistant-results-feature-copy {
  flex: 1;
  min-width: 0;
}

.assistant-results-feature-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #10243d;
}

.assistant-results-feature-summary {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #6882a2;
}

.assistant-results-feature-toggle {
  flex: 0 0 auto;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(238, 245, 255, 0.96);
  border: 1rpx solid rgba(194, 214, 240, 0.76);
  color: #2c6cdf;
  font-size: 21rpx;
  font-weight: 700;
}

.assistant-results-feature-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.assistant-results-feature-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 6rpx;
}

.assistant-results-feature-card {
  width: 280rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #ffffff 0%, #f7faff 100%);
  border: 1rpx solid rgba(194, 214, 240, 0.72);
  flex-shrink: 0;
}

.assistant-results-feature-image {
  width: 100%;
  height: 168rpx;
  display: block;
}

.assistant-results-feature-card-copy {
  padding: 16rpx;
}

.assistant-results-feature-badge {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.assistant-results-feature-badge--active {
  background: rgba(44, 108, 223, 0.12);
  color: #2c6cdf;
}

.assistant-results-feature-badge--default {
  background: rgba(127, 149, 173, 0.16);
  color: #5f7591;
}

.assistant-results-feature-card-title {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #10243d;
}

.assistant-results-feature-card-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #567391;
}

.assistant-results-feature-card-note {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #6882a2;
}

.tap-scale {
  transform: scale(0.985);
  opacity: 0.94;
}

@keyframes assistantModelFlow {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(240%);
  }
}

@media (max-width: 375px) {
  .assistant-results-head,
  .assistant-results-row,
  .assistant-results-feature-head,
  .assistant-model-head {
    flex-direction: column;
  }

  .assistant-model-metric-row {
    grid-template-columns: 1fr;
  }

  .assistant-model-chip-row,
  .assistant-model-live-visual {
    grid-template-columns: 1fr;
  }

  .assistant-model-pulse-line {
    height: 34rpx;
    width: 6rpx;
    justify-self: center;
  }
}
