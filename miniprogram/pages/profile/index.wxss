.profile-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-hero,
.profile-sheet {
  border-radius: 40rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 20rpx 72rpx rgba(48, 70, 55, 0.06);
}

.profile-hero {
  padding: 34rpx 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(245, 248, 245, 0.99) 100%);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-sheet {
  padding: 34rpx 30rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.profile-hero-head,
.profile-log-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.profile-identity {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #69c471 0%, #3f8c4c 100%);
  color: #f3fffb;
  font-size: 40rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.profile-user-copy,
.profile-log-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 42rpx;
  line-height: 1.14;
  font-weight: 700;
  color: var(--text-primary);
}

.profile-student-no {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.profile-credit-status {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--accent-strong);
}

.profile-score-block {
  min-width: 158rpx;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #55a860 0%, #367e46 100%);
  flex-shrink: 0;
  box-sizing: border-box;
}

.profile-score-value {
  display: block;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 700;
  color: #f3fffb;
}

.profile-score-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(243, 255, 243, 0.74);
}

.profile-metric-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  overflow: hidden;
  border-radius: 30rpx;
  background: rgba(246, 250, 245, 0.98);
  border: 1rpx solid rgba(34, 52, 42, 0.05);
}

.profile-metric-item {
  padding: 22rpx 10rpx 24rpx;
  text-align: center;
  border-right: 1rpx solid var(--line);
}

.profile-metric-item:last-child {
  border-right: none;
}

.profile-metric-value {
  display: block;
  font-size: 32rpx;
  line-height: 1.1;
  font-weight: 700;
  color: var(--text-primary);
}

.profile-metric-label {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--text-secondary);
}

.profile-actions .secondary-btn {
  background: rgba(255, 255, 255, 0.96);
}

.profile-section {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.profile-divider {
  height: 1rpx;
  background: var(--line);
}

.profile-rule-list,
.profile-log-list {
  display: flex;
  flex-direction: column;
}

.profile-log-list {
  gap: 14rpx;
}

.profile-rule-row,
.profile-log-row {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
}

.profile-rule-row {
  border-top: 1rpx solid var(--line);
}

.profile-rule-row:first-child {
  padding-top: 0;
  border-top: none;
}

.profile-rule-row {
  align-items: center;
  justify-content: space-between;
}

.profile-rule-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.profile-rule-value {
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text-primary);
}

.profile-log-marker {
  width: 8rpx;
  align-self: stretch;
  min-height: 96rpx;
  margin-top: 2rpx;
  margin-bottom: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #55a860 0%, rgba(85, 168, 96, 0.22) 100%);
  flex-shrink: 0;
}

.profile-log-row {
  align-items: stretch;
  padding: 24rpx 22rpx;
  border-radius: 30rpx;
  background: rgba(247, 251, 246, 0.98);
  border: 1rpx solid rgba(89, 142, 95, 0.11);
  box-shadow: 0 12rpx 30rpx rgba(48, 70, 55, 0.045);
  box-sizing: border-box;
}

.profile-log-head {
  align-items: center;
}

.profile-log-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.32;
  font-weight: 700;
  color: var(--text-primary);
}

.profile-log-delta {
  min-width: 96rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(111, 123, 114, 0.12);
  color: var(--text-secondary);
  font-size: 27rpx;
  line-height: 1;
  font-weight: 700;
  box-sizing: border-box;
  flex-shrink: 0;
}

.profile-log-delta text {
  display: block;
  line-height: 58rpx;
  height: 58rpx;
  text-align: center;
}

.profile-log-delta--positive {
  background: rgba(53, 141, 84, 0.13);
  color: var(--success);
}

.profile-log-delta--negative {
  background: rgba(211, 93, 87, 0.12);
  color: var(--danger);
}

.profile-log-time,
.profile-log-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.52;
  color: var(--text-secondary);
}

.profile-log-time {
  margin-top: 18rpx;
}

.profile-settings {
  display: flex;
  flex-direction: column;
}

.profile-empty-state {
  padding-top: 34rpx;
  padding-bottom: 34rpx;
}

.profile-logout-btn {
  width: 100%;
  min-height: 88rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1.2;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(168, 90, 87, 0.22);
  color: var(--danger);
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

@media (max-width: 375px) {
  .profile-hero,
  .profile-sheet {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .profile-hero-head {
    flex-direction: column;
    align-items: flex-start;
  }

  .profile-log-head {
    flex-direction: row;
    align-items: center;
  }

  .profile-score-block {
    width: 100%;
  }

  .profile-metric-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .profile-metric-item:nth-child(2n) {
    border-right: none;
  }

  .profile-metric-item:nth-child(n + 3) {
    border-top: 1rpx solid var(--line);
  }
}
