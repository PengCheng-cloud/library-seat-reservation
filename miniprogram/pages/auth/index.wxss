.auth-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 64rpx;
}

.auth-brand {
  position: relative;
  z-index: 1;
  margin-bottom: 30rpx;
  text-align: center;
}

.auth-logo {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #1f56b8 0%, #4b88ef 60%, #88b4ff 100%);
  border: 8rpx solid rgba(255, 255, 255, 0.34);
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.auth-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #10243d;
  letter-spacing: 1rpx;
}

.auth-subtitle {
  display: block;
  width: 88%;
  margin: 14rpx auto 0;
  font-size: 24rpx;
  line-height: 1.8;
  color: #6782a3;
}

.auth-tags {
  justify-content: center;
  margin-top: 20rpx;
}

.auth-card {
  padding-top: 24rpx;
  padding-bottom: 32rpx;
}

.auth-tab-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #edf4ff 0%, #f4f8ff 100%);
  border: 1rpx solid rgba(194, 214, 240, 0.68);
  margin-bottom: 24rpx;
}

.auth-tab {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6f87a3;
}

.auth-tab--active {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  color: #2c6cdf;
}

.auth-notice {
  padding: 22rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f7fbff 0%, #eef5ff 100%);
  border: 1rpx solid rgba(194, 214, 240, 0.72);
  margin-bottom: 24rpx;
}

.auth-notice-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #184ea5;
}

.auth-notice-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #6782a3;
}

.auth-feedback {
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.auth-feedback--error {
  background: rgba(210, 75, 97, 0.13);
  color: #cc546a;
}

.auth-feedback--warning {
  background: rgba(202, 138, 29, 0.14);
  color: #b7791f;
}

.auth-feedback--info {
  background: rgba(44, 108, 223, 0.08);
  color: #2c6cdf;
}

.auth-form {
  display: flex;
  flex-direction: column;
}

.auth-field {
  margin-top: 24rpx;
}

.auth-submit {
  margin-top: 34rpx;
  width: 100%;
}
