.showcase-detail-hero {
  padding: 0;
  min-height: 420rpx;
  overflow: hidden;
}

.showcase-detail-image,
.showcase-detail-mask {
  position: absolute;
  inset: 0;
}

.showcase-detail-mask {
  background: linear-gradient(180deg, rgba(16, 36, 61, 0.08) 0%, rgba(12, 34, 76, 0.82) 100%);
}

.showcase-detail-copy {
  position: relative;
  z-index: 1;
  min-height: 420rpx;
  padding: 34rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-sizing: border-box;
}

.showcase-detail-title {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
}

.showcase-detail-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.showcase-detail-summary {
  display: block;
  font-size: 24rpx;
  line-height: 1.8;
  color: #4f6785;
}

.showcase-detail-tags {
  margin-top: 16rpx;
}

.showcase-point-list {
  display: grid;
  gap: 14rpx;
  margin-top: 22rpx;
}

.showcase-point-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.showcase-point-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  flex: 0 0 auto;
  background: #2c6cdf;
}

.showcase-point-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.7;
  color: #4f6785;
}

.showcase-detail-btn {
  width: 100%;
  margin-top: 24rpx;
}

.showcase-gallery {
  display: grid;
  gap: 18rpx;
}

.showcase-gallery-card {
  overflow: hidden;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f7faff 100%);
  border: 1rpx solid rgba(194, 214, 240, 0.72);
}

.showcase-gallery-image {
  width: 100%;
  height: 280rpx;
}

.showcase-gallery-body {
  padding: 22rpx 22rpx 24rpx;
}

.showcase-gallery-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #10243d;
}

.showcase-gallery-head {
  display: grid;
  gap: 12rpx;
}

.showcase-gallery-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #6882a2;
}
