.home-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.home-hero {
  position: relative;
  min-height: 572rpx;
  overflow: hidden;
  border-radius: 42rpx;
  background: linear-gradient(140deg, #4a9455 0%, #66ba6e 48%, #8ed585 100%);
  box-shadow: 0 28rpx 72rpx rgba(52, 73, 58, 0.18);
}

.home-hero-image,
.home-hero-mask {
  position: absolute;
  inset: 0;
}

.home-hero-image {
  width: 100%;
  height: 100%;
}

.home-hero-mask {
  background:
    linear-gradient(180deg, rgba(20, 32, 24, 0.14) 0%, rgba(20, 32, 24, 0.44) 56%, rgba(20, 32, 24, 0.78) 100%),
    linear-gradient(120deg, rgba(203, 241, 195, 0.24) 0%, rgba(203, 241, 195, 0.05) 52%, rgba(77, 144, 87, 0.22) 100%);
}

.home-hero-content {
  position: relative;
  z-index: 1;
  min-height: 572rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 24rpx;
}

.home-hero-top,
.home-user-chip,
.home-shortcut,
.home-panel-head,
.home-preference-head,
.home-notice-banner,
.home-zone-row,
.home-zone-inline {
  display: flex;
  align-items: center;
}

.home-hero-top,
.home-panel-head,
.home-notice-banner {
  justify-content: space-between;
  gap: 16rpx;
}

.home-panel-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.home-user-chip {
  flex: 1;
  min-width: 0;
  gap: 16rpx;
}

.home-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.home-user-copy,
.home-notice-banner-copy {
  flex: 1;
  min-width: 0;
}

.home-greeting {
  display: block;
  font-size: 34rpx;
  line-height: 1.16;
  font-weight: 700;
  color: #ffffff;
}

.home-user-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.home-profile-link {
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.16);
  color: #ffffff;
}

.home-hero-main {
  max-width: 520rpx;
}

.home-hero-tags {
  margin-bottom: 18rpx;
}

.home-hero-title {
  display: block;
  font-size: 66rpx;
  line-height: 1.02;
  font-weight: 700;
  color: #ffffff;
}

.home-hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.68;
  color: rgba(255, 255, 255, 0.9);
}

.home-hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.home-hero-metric {
  min-height: 110rpx;
  padding: 18rpx 16rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-sizing: border-box;
}

.home-hero-metric-value {
  display: block;
  font-size: 31rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #ffffff;
}

.home-hero-metric-label {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.54;
  color: rgba(255, 255, 255, 0.72);
}

.home-shortcut-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10rpx;
  padding: 0 4rpx;
  width: 100%;
  min-width: 0;
}

.home-shortcut {
  flex-direction: column;
  justify-content: flex-start;
  gap: 10rpx;
  min-width: 0;
}

.home-shortcut-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(39, 72, 43, 0.18);
}

.home-shortcut-icon--green {
  background: linear-gradient(180deg, #69c471 0%, #3f8c4c 100%);
}

.home-shortcut-icon--cyan {
  background: linear-gradient(180deg, #7ccc74 0%, #4c9b58 100%);
}

.home-shortcut-icon--mint {
  background: linear-gradient(180deg, #8bd17b 0%, #5aa462 100%);
}

.home-shortcut-icon--lime {
  background: linear-gradient(180deg, #a0d883 0%, #6aad57 100%);
}

.home-shortcut-icon--dark {
  background: linear-gradient(180deg, #5da96a 0%, #357642 100%);
}

.home-shortcut-label {
  display: block;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.42;
  color: var(--text-primary);
  min-width: 0;
}

.home-stage-grid {
  display: grid;
  grid-template-columns: 1.22fr 1fr;
  grid-template-rows: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  min-height: 320rpx;
  width: 100%;
  min-width: 0;
}

.home-stage-card {
  padding: 26rpx 24rpx;
  border-radius: 34rpx;
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  text-align: left;
  box-sizing: border-box;
  box-shadow: 0 16rpx 34rpx rgba(52, 73, 58, 0.08);
  border: 1rpx solid var(--line);
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.home-stage-card--primary {
  grid-row: span 2;
  background: linear-gradient(180deg, #edf9eb 0%, #ddf0db 100%);
}

.home-stage-card--aqua {
  background: linear-gradient(180deg, #f1fbef 0%, #e4f4e2 100%);
}

.home-stage-card--mint {
  background: linear-gradient(180deg, #f6fbf4 0%, #ebf6e9 100%);
}

.home-stage-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.14;
  font-weight: 700;
  color: var(--text-primary);
  word-break: break-word;
}

.home-stage-desc {
  display: block;
  width: 100%;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.64;
  color: var(--text-secondary);
  word-break: break-word;
}

.home-stage-action {
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-strong);
  border: 1rpx solid transparent;
  font-size: 22rpx;
  font-weight: 700;
  box-sizing: border-box;
  color: #ffffff;
  white-space: nowrap;
}

.home-notice-banner,
.home-panel {
  padding: 22rpx 22rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid var(--line);
  box-shadow: 0 18rpx 44rpx rgba(48, 70, 55, 0.08);
  box-sizing: border-box;
}

.home-notice-banner {
  justify-content: flex-start;
  gap: 16rpx;
}

.home-notice-banner-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.home-notice-banner-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--accent);
  flex-shrink: 0;
}

.home-notice-banner-title {
  display: block;
  font-size: 26rpx;
  line-height: 1.34;
  font-weight: 700;
  color: var(--text-primary);
}

.home-notice-banner-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.62;
  color: var(--text-secondary);
}

.home-notice-banner-type {
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: 20rpx;
  box-sizing: border-box;
}

.home-notice-banner-link {
  display: block;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--accent-strong);
}

.home-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-width: 0;
}

.home-panel-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.22;
  font-weight: 700;
  color: var(--text-primary);
  word-break: break-word;
}

.home-panel-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.62;
  color: var(--text-secondary);
}

.home-filter-strip {
  width: 100%;
  white-space: nowrap;
}

.home-filter-track {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 6rpx;
}

.home-filter-chip {
  width: 246rpx;
  min-height: 214rpx;
  padding: 22rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  text-align: left;
  box-sizing: border-box;
  color: var(--text-primary);
  flex-shrink: 0;
  border: 1rpx solid var(--line);
  box-shadow: 0 14rpx 30rpx rgba(52, 73, 58, 0.06);
  overflow: hidden;
}

.home-filter-chip--green {
  background: linear-gradient(180deg, #edf9eb 0%, #ddf0db 100%);
}

.home-filter-chip--cyan {
  background: linear-gradient(180deg, #f1fbef 0%, #e4f4e2 100%);
}

.home-filter-chip--mint {
  background: linear-gradient(180deg, #f6fbf4 0%, #ebf6e9 100%);
}

.home-filter-chip--lime {
  background: linear-gradient(180deg, #f9fcf5 0%, #eef6ea 100%);
}

.home-filter-chip--more {
  background: rgba(255, 255, 255, 0.985);
}

.home-filter-chip-label {
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-soft);
  font-size: 19rpx;
  letter-spacing: 1rpx;
  box-sizing: border-box;
  color: var(--accent-strong);
}

.home-filter-chip--more .home-filter-chip-label {
  background: rgba(63, 140, 76, 0.1);
  color: var(--accent-strong);
}

.home-filter-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.18;
  font-weight: 700;
  color: var(--text-primary);
  word-break: break-word;
}

.home-filter-subtitle {
  display: block;
  font-size: 22rpx;
  line-height: 1.56;
  color: var(--text-secondary);
  word-break: break-word;
}

.home-filter-chip--more .home-filter-subtitle {
  color: var(--text-secondary);
}

.home-filter-tags {
  gap: 8rpx;
}

.home-filter-tag {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(63, 140, 76, 0.08);
  border: 1rpx solid rgba(63, 140, 76, 0.08);
  color: var(--accent-strong);
  font-size: 20rpx;
  box-sizing: border-box;
}

.home-filter-action {
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-strong);
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
  color: #ffffff;
  white-space: nowrap;
  box-shadow: 0 10rpx 24rpx rgba(63, 140, 76, 0.18);
}

.home-filter-chip--more .home-filter-action {
  background: var(--accent-strong);
  color: #ffffff;
}

.home-zone-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  min-width: 0;
}

.home-zone-tile {
  min-height: 208rpx;
  padding: 22rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  text-align: left;
  box-sizing: border-box;
  color: var(--text-primary);
  box-shadow: 0 14rpx 28rpx rgba(52, 73, 58, 0.06);
  border: 1rpx solid var(--line);
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.home-zone-tile--green {
  background: linear-gradient(180deg, #edf9eb 0%, #ddf0db 100%);
}

.home-zone-tile--cyan {
  background: linear-gradient(180deg, #f1fbef 0%, #e4f4e2 100%);
}

.home-zone-code {
  display: block;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--accent-strong);
}

.home-zone-name {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.32;
  font-weight: 700;
  color: var(--text-primary);
  word-break: break-word;
}

.home-zone-note,
.home-zone-meta {
  display: block;
  font-size: 21rpx;
  line-height: 1.58;
  color: var(--text-secondary);
  word-break: break-word;
}

.home-zone-meta {
  margin-top: 6rpx;
}

.home-zone-link {
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-soft);
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
  color: var(--accent-strong);
  white-space: nowrap;
}

.home-zone-entry {
  width: 100%;
  min-height: 78rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(246, 251, 245, 0.98);
  border: 1rpx solid var(--line);
  color: var(--accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.home-empty-state {
  padding: 28rpx 12rpx;
}

.tap-scale {
  transform: scale(0.985);
  opacity: 0.94;
}

@media (max-width: 375px) {
  .home-hero-content,
  .home-notice-banner,
  .home-panel {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .home-hero-top,
  .home-panel-head,
  .home-notice-banner {
    align-items: flex-start;
  }

  .home-panel-head {
    gap: 14rpx;
  }

  .home-stage-card,
  .home-zone-tile {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }
}
