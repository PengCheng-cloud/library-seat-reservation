.preference-page {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.preference-hero,
.preference-panel {
  padding: 28rpx 26rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid var(--line);
  box-shadow: 0 18rpx 44rpx rgba(48, 70, 55, 0.08);
  box-sizing: border-box;
}

.preference-hero {
  background: linear-gradient(135deg, #4f9959 0%, #69bd70 46%, #95d68b 100%);
}

.preference-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 2.8rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.74);
}

.preference-title {
  display: block;
  margin-top: 12rpx;
  font-size: 52rpx;
  line-height: 1.06;
  font-weight: 700;
  color: #ffffff;
}

.preference-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.68;
  color: rgba(255, 255, 255, 0.9);
}

.preference-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.preference-hero-btn {
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.preference-hero-btn--ghost {
  background: rgba(255, 255, 255, 0.1);
}

.preference-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.preference-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.preference-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.preference-action-card {
  min-height: 236rpx;
  padding: 22rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  text-align: left;
  box-sizing: border-box;
  color: var(--text-primary);
  box-shadow: 0 14rpx 28rpx rgba(52, 73, 58, 0.06);
  border: 1rpx solid var(--line);
  overflow: hidden;
}

.preference-action-card--green {
  background: linear-gradient(180deg, #edf9eb 0%, #ddf0db 100%);
}

.preference-action-card--cyan {
  background: linear-gradient(180deg, #f1fbef 0%, #e4f4e2 100%);
}

.preference-action-card--mint {
  background: linear-gradient(180deg, #f6fbf4 0%, #ebf6e9 100%);
}

.preference-action-card--lime {
  background: linear-gradient(180deg, #f9fcf5 0%, #eef6ea 100%);
}

.preference-action-label {
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-soft);
  font-size: 19rpx;
  letter-spacing: 1rpx;
  box-sizing: border-box;
  color: var(--accent-strong);
}

.preference-action-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.18;
  font-weight: 700;
  color: var(--text-primary);
  word-break: break-word;
}

.preference-action-subtitle {
  display: block;
  font-size: 22rpx;
  line-height: 1.56;
  color: var(--text-secondary);
  word-break: break-word;
}

.preference-action-tags {
  gap: 8rpx;
}

.preference-action-tag {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(63, 140, 76, 0.08);
  border: 1rpx solid rgba(63, 140, 76, 0.08);
  color: var(--accent-strong);
  font-size: 20rpx;
  box-sizing: border-box;
}

.preference-action-link {
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-strong);
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
  color: #ffffff;
  white-space: nowrap;
}

.preference-facility-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.preference-facility-item {
  overflow: hidden;
  border-radius: 28rpx;
  background: rgba(247, 251, 246, 0.98);
  border: 1rpx solid var(--line);
}

.preference-facility-image {
  width: 100%;
  height: 176rpx;
}

.preference-facility-body {
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.preference-facility-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.26;
  font-weight: 700;
  color: var(--text-primary);
}

.preference-facility-subtitle {
  display: block;
  font-size: 22rpx;
  line-height: 1.66;
  color: var(--text-secondary);
}

@media (max-width: 375px) {
  .preference-hero,
  .preference-panel {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .preference-action-grid,
  .preference-facility-grid {
    grid-template-columns: 1fr;
  }
}
